        <Position x="246" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <OrderChanged value="False" />
          <SelectFields>
            <SelectField field="OrderID" selected="True" type="Int64" />
            <SelectField field="Customer" selected="True" rename="CustomerName" />
            <SelectField field="Amount" selected="True" type="Double" />
            <SelectField field="Status" selected="False" />
            <SelectField field="*Unknown" selected="True" />
          </SelectFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <DefaultAnnotationText>Rename and type columns</DefaultAnnotationText>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxSelect" />
