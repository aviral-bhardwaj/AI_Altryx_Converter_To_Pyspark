          <Expression>[Status] = 'Active' AND [Amount] > 100</Expression>
          <Mode>Custom</Mode>
        </Configuration>
        <Annotation DisplayMode="0">
          <DefaultAnnotationText>Active high value orders</DefaultAnnotationText>
        </Annotation>
